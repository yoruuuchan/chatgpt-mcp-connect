# Copy outside the checkout and fill in deployment-specific values.
# Never commit a filled-in copy. Raw secrets are intentionally absent: the QQ
# authorization code is provisioned once through stdin into the keychain, while
# the OAuth owner token and Cloudflare Tunnel token are referenced by file.

# Provisioning input; mail-mcp does not expand this inside accounts.json.
QQ_MAIL_ADDRESS=YOUR_QQ_NUMBER@qq.com

# mail-mcp provisioning values. The bridge unit maps these paths onto HOME and
# XDG_* for its own service account; the OAuth gateway does not inherit them.
MAIL_MCP_HOME=/var/lib/mailmcp
MAIL_MCP_XDG_CONFIG_HOME=/var/lib/mailmcp/.config
MAIL_MCP_XDG_DATA_HOME=/var/lib/mailmcp/.local/share
MAIL_MCP_KEYRING_BACKEND=file

# OAuth gateway. PUBLIC_BASE_URL has no trailing slash and no /mcp path.
PUBLIC_BASE_URL=https://qq-mail-mcp.example.com
OWNER_TOKEN_FILE=/etc/qq-mail-mcp/owner-token.txt
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=18770
UPSTREAM_PATH=/mcp
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18771
MCP_PATH=/mcp
SCOPE=qq-mail
RESOURCE_NAME="QQ Mail MCP"
STATE_DIR=/var/lib/qqmailoauth/gateway-state
ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
BODY_LIMIT=32mb

# Path referenced by the cloudflared systemd unit as:
# cloudflared tunnel run --token-file "$CLOUDFLARED_TOKEN_FILE"
CLOUDFLARED_TOKEN_FILE=/etc/qq-mail-mcp/cloudflared.token
