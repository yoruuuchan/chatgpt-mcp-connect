# Copy to .env and fill in. Never commit the filled-in copy.
# Every value below is read by gateway.mjs at startup.

# ---------------------------------------------------------------- required ---

# The public HTTPS origin ChatGPT will talk to. No trailing slash, no path.
# This must match the hostname you route through Cloudflare Tunnel / Tailscale
# Funnel, or OAuth discovery will hand ChatGPT the wrong issuer and the flow
# will fail in a way that is very hard to read from the ChatGPT side.
PUBLIC_BASE_URL=https://mcp.example.com

# The single credential a human types on the consent screen to authorize a
# client. Treat it like a root password: it grants whatever your MCP server can do.
# Generate one:  openssl rand -hex 32
# Prefer OWNER_TOKEN_FILE over OWNER_TOKEN so the secret never sits in a
# process listing or a shell history.
OWNER_TOKEN_FILE=./secrets/owner-token.txt
# OWNER_TOKEN=

# ---------------------------------------------------------------- upstream ---

# Where your existing MCP server is already listening. It must speak Streamable
# HTTP. If yours is stdio-only, put mcp-proxy in front of it first and point
# these at the proxy — see docs/architecture.md.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8770
UPSTREAM_PATH=/mcp

# If your MCP server has its own bearer auth, put the full header value here and
# the gateway will swap the caller's OAuth token for it. Omit if it has none.
UPSTREAM_AUTHORIZATION_FILE=./secrets/upstream-authorization.txt
# UPSTREAM_AUTHORIZATION=Bearer xxxxxxxx

# ----------------------------------------------------------------- gateway ---

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8771

# Path ChatGPT connects to, on both the public URL and this gateway.
MCP_PATH=/mcp

# OAuth scope name. Any short identifier; it shows up on the consent screen.
SCOPE=mcp

# Human-readable name shown during authorization.
RESOURCE_NAME=My MCP server

# Where the SQLite file holding client registrations, codes and tokens lives.
# Back it up or don't — losing it just forces ChatGPT to re-authorize.
STATE_DIR=./gateway-state

# ---------------------------------------------------------------- optional ---

# Hosts allowed as OAuth redirect targets. ChatGPT needs chatgpt.com; localhost
# entries let you test the flow with a local MCP client first.
ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Raise if your tools return large payloads (screenshots, renders).
BODY_LIMIT=32mb

# Only needed if @waishnav/devspace is installed somewhere this gateway cannot
# resolve on its own — e.g. a global npm install rather than a local one.
# DEVSPACE_ROOT=/path/to/node_modules/@waishnav/devspace
